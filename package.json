{
  "name": "cloudflare-container-mirror",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "check": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "npm run build && node --import tsx scripts/test.ts",
    "dev": "npm run build && wrangler dev --no-bundle",
    "deploy": "npm run check && npm run build && wrangler deploy --no-bundle",
    "test:ui": "node --import tsx --test tests/image-commands.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  }
}
